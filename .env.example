# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Runtime-only ByteBrew Web configuration. Do not commit real values.
BYTEBREW_WEB_APP_ID=""
BYTEBREW_WEB_SDK_KEY=""
# All analytics currently use this pre-release version plus test_tag=not_deployed.
BYTEBREW_APP_VERSION="0.0.0-test"
